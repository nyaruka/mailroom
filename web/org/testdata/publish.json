[
    {
        "label": "event must be an object",
        "method": "POST",
        "path": "/mi/org/publish",
        "body": {
            "org_id": 1,
            "event": null
        },
        "status": 400,
        "response": {
            "error": "event must be a JSON object"
        }
    },
    {
        "label": "event must have a type",
        "method": "POST",
        "path": "/mi/org/publish",
        "body": {
            "org_id": 1,
            "event": {
                "asset": {
                    "type": "flow",
                    "uuid": "9de3663f-c5c5-4c92-9f45-ecbc09abcc85",
                    "name": "Registration"
                }
            }
        },
        "status": 400,
        "response": {
            "error": "event must have a type"
        }
    },
    {
        "label": "event type must be a string",
        "method": "POST",
        "path": "/mi/org/publish",
        "body": {
            "org_id": 1,
            "event": {
                "type": 12345
            }
        },
        "status": 400,
        "response": {
            "error": "event must have a type"
        }
    },
    {
        "label": "org must exist",
        "method": "POST",
        "path": "/mi/org/publish",
        "body": {
            "org_id": 1234567,
            "event": {
                "type": "asset_changed"
            }
        },
        "status": 400,
        "response": {
            "error": "no such org with id 1234567"
        }
    },
    {
        "label": "publish asset change",
        "method": "POST",
        "path": "/mi/org/publish",
        "body": {
            "org_id": 1,
            "event": {
                "type": "asset_changed",
                "asset": {
                    "type": "flow",
                    "uuid": "9de3663f-c5c5-4c92-9f45-ecbc09abcc85",
                    "name": "Registration"
                }
            }
        },
        "status": 200,
        "response": {}
    }
