        "method": "POST",
        "path": "/mi/knowledge/search",
        "body": {
            "org_id": 1,
            "query": "how do refunds work?"
        },
        "status": 200,
        "response": {
            "results": []
        }
    },
    {
        "label": "error if a source isn't a UUID",
        "method": "POST",
        "path": "/mi/knowledge/search",
        "body": {
            "org_id": 1,
            "query": "how do refunds work?",
            "source_uuids": ["xyz"]
        },
        "status": 400,
        "response": {
            "error": "request failed validation: field 'source_uuids[0]' must be a valid UUID"
        }
    },
    {
        "label": "empty results if nothing indexed for the given sources",
        "method": "POST",
        "path": "/mi/knowledge/search",
        "body": {
            "org_id": 1,
            "query": "how do refunds work?",
            "source_uuids": ["5384b1c6-1099-4a5f-a005-9d3a4092c5c1"]
        },
        "status": 200,
        "response": {
            "results": []
        }
    }
